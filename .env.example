# Copy local overrides to `.env.local` (`.env.local` is gitignored; never commit real secrets).
# Values below are documentation-only unless you set them in shell env or private `.env.local`.

# --- FastAPI / React defense quickstart (minimum recommended set) ---
# Fill these first for the current Python + React stack:
# SQL_AGENT_DATABASE_URL=postgresql+psycopg://sql_agent:sql_agent@127.0.0.1:5432/sql_agent
# SQL_AGENT_CHAT_BASE_URL=
# SQL_AGENT_CHAT_API_KEY=
# SQL_AGENT_CHAT_MODEL=
# SQL_AGENT_EMBEDDING_BASE_URL=
# SQL_AGENT_EMBEDDING_API_KEY=
# SQL_AGENT_EMBEDDING_MODEL=
# SQL_AGENT_EMBEDDING_DIMENSION=1024
# Legacy Spring keys below are preserved for brownfield reference only.

# --- Legacy Spring Boot (Java) datasource — JDBC URL, user, password (optional if not running legacy) ---
SPRING_DATASOURCE_URL= # Full JDBC URL for the Spring-managed PostgreSQL metadata store (e.g. jdbc:postgresql://127.0.0.1:5432/app)
SPRING_DATASOURCE_USERNAME= # Database user for SPRING_DATASOURCE_URL
SPRING_DATASOURCE_PASSWORD= # Database password for SPRING_DATASOURCE_URL

# --- Spring AI — Azure OpenAI (used by Spring beans and ChatGPTModel LangChain4j builders) ---
SPRING_AI_AZURE_OPENAI_API_KEY= # Azure OpenAI API key (never commit)
SPRING_AI_AZURE_OPENAI_ENDPOINT= # e.g. https://YOUR_RESOURCE.openai.azure.com/
SPRING_AI_AZURE_OPENAI_DEPLOYMENT_NAME= # Deployment name for chat completions
SPRING_AI_AZURE_OPENAI_MODEL= # Model id as exposed by your deployment (often matches deployment name)

# --- Spring AI — DashScope (Alibaba) chat + embeddings ---
SPRING_AI_DASHSCOPE_API_KEY= # DashScope API key for chat and compatible-mode embedding calls
SPRING_AI_DASHSCOPE_CHAT_MODEL= # e.g. qwen3-max — chat model id for spring.ai.dashscope

# --- Legacy brownfield MySQL JSON (optional) — full JSON per datasource when not using localhost stub ---
SQL_AGENT_LEGACY_DS_CAR_JSON= # Optional: JSON blob for CAR_CONFIG (see DBConstants)
SQL_AGENT_LEGACY_DS_HR_JSON= # Optional: JSON blob for HR_CONFIG
SQL_AGENT_LEGACY_DS_FIN_JSON= # Optional: JSON blob for FIN_CONFIG
SQL_AGENT_LEGACY_DS_SECURITY_JSON= # Optional: JSON blob for SECURITY_CONFIG
SQL_AGENT_LEGACY_DS_STOCK_JSON= # Optional: JSON blob for STOCK_CONFIG

# --- Docker Compose: PostgreSQL 18 (`docker compose` loads root `.env` via `env_file: .env` — copy from this file) ---
# Example credentials only; set real values in your private `.env` (never commit `.env`).
# The Compose backend derives its in-network DSN from these POSTGRES_* values automatically.
POSTGRES_USER=sql_agent
POSTGRES_PASSWORD=sql_agent
POSTGRES_DB=sql_agent

# --- New FastAPI / SQLAlchemy system database (fake example values — replace in `.env`) ---
# Host dev (`uv run` on machine, Postgres from Compose): use 127.0.0.1.
# Full stack Compose derives the backend container DSN from POSTGRES_* above; this variable is for host-run backend and non-Compose flows.
SQL_AGENT_DATABASE_URL=postgresql+psycopg://sql_agent:sql_agent@127.0.0.1:5432/sql_agent
SQL_AGENT_DB_POOL_SIZE=5 # App-side pool size for async SQLAlchemy
SQL_AGENT_DB_MAX_OVERFLOW=10 # Extra connections beyond pool size under burst load
SQL_AGENT_QUERY_MAX_ROWS=500 # Hard cap for rows fetched from a business datasource
SQL_AGENT_QUERY_TIMEOUT_MS=30000 # PostgreSQL/MySQL statement timeout; <=0 disables it
SQL_AGENT_ENV=dev # e.g. dev, test, prod
SQL_AGENT_SKIP_DB_LIFESPAN=0 # Set to 1 in pytest to skip SELECT 1 during app lifespan

# --- Optional Langfuse observability (disabled unless explicitly enabled) ---
SQL_AGENT_OBSERVABILITY_ENABLED=0
SQL_AGENT_OBSERVABILITY_CAPTURE_CONTENT=0 # Keep prompts, SQL and results out of traces by default
SQL_AGENT_OBSERVABILITY_SAMPLE_RATE=1.0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com # Or your self-hosted endpoint

# --- OpenAI-compatible chat / reasoning (FastAPI — Plan 01-02 contract) ---
SQL_AGENT_CHAT_BASE_URL= # e.g. https://api.openai.com/v1 or compatible gateway
SQL_AGENT_CHAT_API_KEY= # Provider API key for chat
SQL_AGENT_CHAT_MODEL= # Reasoning/chat model id

# --- OpenAI-compatible embedding (split from chat — D-18) ---
SQL_AGENT_EMBEDDING_BASE_URL= # May match chat gateway or a dedicated embedding endpoint
SQL_AGENT_EMBEDDING_API_KEY= # API key for embedding calls (can match chat if same provider)
SQL_AGENT_EMBEDDING_MODEL= # Embedding model id (dimension must match DB / migrations)
SQL_AGENT_EMBEDDING_DIMENSION=1024 # Vector width for pgvector `knowledge_chunks.embedding` (must match model output)

# --- Target business DBs for `/api/v1/execution/run` (JSON array of { "id": string, "engine": "postgres"|"mysql", "url": "driver URL" }) ---
SQL_AGENT_DATASOURCES_JSON=

# --- Datasource-scoped learning loop (Phase 8+) ---
SQL_AGENT_RUNTIME_MEMORY_CHAR_BUDGET=2200 # Max characters injected from active datasource memory per turn
SQL_AGENT_DATASOURCE_MEMORY_CHAR_BUDGET=7000 # Max total active-memory characters retained per datasource before archival
SQL_AGENT_MEMORY_AUTO_ACTIVATE_THRESHOLD=0.82 # High-confidence runtime memory at or above this threshold auto-activates
SQL_AGENT_THREAD_CONTEXT_CHAR_BUDGET=7000 # Trigger rolling compression when raw thread context grows beyond this size
SQL_AGENT_THREAD_SUMMARY_CHAR_BUDGET=2200 # Cap the stored rolling summary text length
SQL_AGENT_THREAD_CONTEXT_TAIL_TURNS=6 # Always keep the most recent raw turns outside the compressed summary
SQL_AGENT_THREAD_CONTEXT_COMPRESSION_MIN_TURNS=8 # Do not compress very short threads
SQL_AGENT_AUTONOMOUS_MAX_STEPS=15 # Main chat Agent max iterations; set to 0 or negative to remove the limit
SQL_AGENT_PROMPT_TIMEZONE=Asia/Shanghai # Wall-clock injected into Agent system prompt for「今天」「近30天」等相对时间
